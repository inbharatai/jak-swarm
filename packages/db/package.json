{
  "name": "@jak-swarm/db",
  "version": "0.1.0-beta.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma",
    "db:push": "prisma db push --schema prisma",
    "db:migrate": "prisma migrate dev --schema prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma",
    "db:migrate:status": "node scripts/migrate-status.js",
    "db:migrate:reset": "prisma migrate reset --schema prisma",
    "db:execute": "prisma db execute --schema prisma --stdin",
    "db:studio": "prisma studio --schema prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:compliance": "tsx prisma/seed-compliance.ts"
  },
  "dependencies": {
    "@jak-swarm/security": "workspace:*",
    "@jak-swarm/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
